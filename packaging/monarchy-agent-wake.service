[Unit]
# SPDX-FileCopyrightText: 2026 Monarchy contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# One bounded agent run per verified comment, on a timer.
#
# This unit is the confinement, not the engine: the engine is named in
# /etc/monarchy-agent-wake.env, which ships absent on purpose. With no engine the
# wake is skipped rather than failed, so the timer can be installed before anyone
# decides what may run inside it.
#
# What the sandbox is for: `opencode run` was measured writing files and running
# shell commands with no approval prompt at all, because a headless run has no
# terminal to ask in. Bounding its time and frequency (scripts/agent-trigger.sh)
# does not bound what it may do; these directives do.
Description=Wake one agent run for a signed comment (bounded)
Documentation=https://github.com/kubuntugamer/monarchy/blob/main/TESTING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=chazz
Group=chazz
EnvironmentFile=-/etc/monarchy-agent-wake.env
# Skipped, not failed, when no engine is named: the timer stays installed and
# silent until someone writes that file.
ExecCondition=/bin/sh -c '[ -n "${MONARCHY_WAKE_ENGINE}" ]'
# A scoped token replaces the account credential for the whole run: the trigger,
# agent-post.sh and git all read GH_TOKEN. The variable holds a *path*, never the
# secret, so the token cannot appear in the unit's environment or in
# `systemctl show`. It is required, not optional - an absent, unreadable or empty
# file stops the run before the engine starts, because the alternative is gh's
# account credential, which may push main. See TESTING.md §7.
#
# LoadCredential= would give a tmpfs copy owned by the unit, but it fails the unit
# when the file is missing; this wrapper refuses in the same place, with a message
# that names the reason, and keeps the path configurable.
ExecStart=/bin/sh -c 'token="$$MONARCHY_WAKE_GH_TOKEN_FILE"; if [ -z "$$token" ] || [ ! -r "$$token" ] || [ ! -s "$$token" ]; then echo "monarchy-agent-wake: no readable scoped token at MONARCHY_WAKE_GH_TOKEN_FILE ($${token:-unset}); refusing to fall back to the account credential" >&2; exit 1; fi; GH_TOKEN=$$(cat "$$token"); export GH_TOKEN; exec /home/chazz/monarchy/scripts/agent-trigger.sh --agent-cmd "${MONARCHY_WAKE_ENGINE}"'
# 600s is the trigger's own --max-runtime default; the rest is verification,
# posting and the engine's own shutdown. For Type=oneshot this is the knob that
# bounds runtime - RuntimeMaxSec= is documented not to apply to oneshot units.
TimeoutStartSec=720

# The worktree and the ledger are the only writable places. Everything else in
# the home directory is readable - the signing key and gh's credential are how a
# run answers at all - but no write outside these two paths can succeed.
ReadWritePaths=/home/chazz/monarchy -/home/chazz/.local/state/monarchy-agent
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# @system-service plus the socket families a model API and DNS need. JIT is left
# alone: MemoryDenyWriteExecute would break every engine worth waking.
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# No IPAddressAllow= here, and that is a measurement rather than an omission.
# IPAddressAllow= alone is not a firewall - the man page's own rule is deny wins
# only when it matches, so an allow list needs IPAddressDeny=any beside it. With
# both set to localhost, the trigger died at "dial tcp 140.82.114.6:443: i/o
# timeout" before it could verify a single comment, and an allowance wide enough
# to reach api.github.com is equally wide enough to push to github.com, because
# they are the same service. Network filtering cannot separate commenting from
# pushing here; a token that may comment and may not write contents can.
UMask=0077
Nice=10
